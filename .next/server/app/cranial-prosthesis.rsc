ndefined"]}],["$","span",null,{"children":"Techniques designed to minimise contact between knots and the scalp"}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check h-4 w-4 text-[#A9153B] shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":"100% natural human hair for authentic look and movement"}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-circle-check h-4 w-4 text-[#A9153B] shrink-0 mt-0.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","path","dzmm74",{"d":"m9 12 2 2 4-4"}],"$undefined"]}],["$","span",null,{"children":"Adjustable elastic band for convenient and secure fit"}]]}]]}]]}]]}],["$","$L2",null,{"direction":"left","className":"lg:col-span-7 space-y-6","children":["$","div",null,{"className":"space-y-6 text-slate-600 text-sm sm:text-base leading-relaxed","children":[["$","p",null,{"children":"A cranial hair prosthesis, commonly known as a medical wig, is specially designed for individuals who experience hair loss due to chemotherapy, alopecia, breast cancer, or other medical conditions. Unlike conventional wigs, medical wigs are custom-made to suit the individual’s scalp, hair requirements, and personal preferences."}],["$","div",null,{"className":"p-6 rounded-2xl bg-slate-50 border-l-4 border-[#A9153B] space-y-3","children":["$","p",null,{"className":"text-slate-800 font-medium text-sm sm:text-base","children":"These wigs are meticulously crafted by trained experts with particular attention to the sensitivity of the scalp. This is especially important during and after chemotherapy, when the scalp can become extremely sensitive and more susceptible to irritation or allergic reactions. The base of the prosthesis is made using scalp-friendly, non-allergenic materials, while the hair is carefully attached using techniques designed to minimise contact between knots and the scalp."}]}],["$","p",null,{"children":"Our medical wigs are made from 100% natural human hair, allowing them to closely replicate the look, texture, and movement of natural hair. The objective is not merely to conceal hair loss, but to provide patients with a natural appearance, comfort, security, and the freedom to carry on with their daily lives with confidence."}],["$","p",null,{"children":"The wigs are designed for convenient and secure use. An adjustable elastic band helps hold the prosthesis comfortably in place, allowing the wearer to use it with ease and confidence."}],["$","p",null,{"children":"Whether you are experiencing hair loss as a result of breast cancer, chemotherapy, alopecia, or another medical condition—or are preparing to undergo chemotherapy—a medical wig can be a practical and reassuring solution. Cranial hair prostheses are available in a variety of hair colours, lengths, textures, and styles, allowing you to select an option that closely matches your natural appearance and provides a comfortable, personalised fit."}],["$","div",null,{"className":"p-6 rounded-2xl bg-[#A9153B]/5 border border-[#A9153B]/20 space-y-2","children":["$","p",null,{"className":"font-bold text-[#A9153B] text-base sm:text-lg","children":"Hair loss may be a part of your medical journey, but it does not have to define you. With the right medical hair prosthesis, you can look like yourself, feel comfortable, and continue your journey with confidence."}]}]]}]}]]}]}]}],["$","section",null,{"className":"py-20 bg-sl